{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "niseko-powder",
	// Deploy to Jeremy's personal Cloudflare account (the login can see several accounts).
	"account_id": "34f0c32cae88c1c1ac463a01217b2221",
	// Custom entry: Astro handles `fetch`, our job registry handles `scheduled` (cron).
	"main": "./src/worker.ts",
	// Latest date supported by the locally installed workerd. Bump when upgrading wrangler.
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	// The Astro adapter (Cloudflare Vite plugin) fills in the assets directory at build time.
	"assets": {
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},
	// Hourly data refresh. Cron runs in UTC; minute 10 gives JMA time to publish the :00 reading.
	"triggers": {
		"crons": ["10 * * * *"],
	},
	// Created by wrangler's auto-provisioning on the first deploy (2026-10-23).
	"kv_namespaces": [
		{
			// Latest normalized `Conditions` JSON (one key per location).
			"binding": "CONDITIONS",
			"id": "644398cd6aa24a779358913c78ece889",
		},
	],
	"d1_databases": [
		{
			// Daily season history (Phase 4).
			"binding": "HISTORY_DB",
			"database_name": "niseko-powder-history",
			"database_id": "d09ab101-de69-4fbc-bc0a-5f6aca599b07",
			"migrations_dir": "migrations",
		},
	],
	"vars": {
		"SITE_ENV": "production",
	},
}
