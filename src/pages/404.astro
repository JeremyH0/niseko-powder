---
import { site } from '../config/site.ts';
import { createTranslator, defineMessages } from '../i18n/index.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const t = createTranslator(
  defineMessages({
    en: {
      title: 'Lost in the trees',
      text: 'This page doesn’t exist. Head back to the groomed run.',
      home: 'Is it a powder day?',
    },
  }),
);
---

<BaseLayout title={`${t('title')} · ${site.name}`} description={t('text')}>
  <main id="main" class="mx-auto flex w-full max-w-xl flex-1 flex-col items-start justify-center px-4 py-24">
    <p class="font-display text-7xl font-black">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold">{t('title')}</h1>
    <p class="mt-2 text-ink-muted">{t('text')}</p>
    <a href="/" class="mt-6 rounded-full bg-ink px-5 py-3 font-semibold text-paper">{t('home')}</a>
  </main>
</BaseLayout>
