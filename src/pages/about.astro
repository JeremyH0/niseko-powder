---
/** Methodology page. Built from the same config the code uses, so it can't drift. Static. */
import { getLocation } from '../config/locations.ts';
import { powderConfig as c } from '../config/powder.ts';
import { site } from '../config/site.ts';
import { aboutStrings } from '../features/about/strings.ts';
import { createTranslator } from '../i18n/index.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../ui/Section.astro';
import PageHeader from '../ui/PageHeader.astro';

export const prerender = true;

const t = createTranslator(aboutStrings);
const location = getLocation();
const s = location.station;
const pts = (n: number) => (n > 0 ? `+${n}` : `−${Math.abs(n)}`);
const toc = (['sources', 'score', 'limits', 'privacy'] as const).map((id) => ({ id, title: t(`${id}.title`) }));
---

<BaseLayout title={`${t('title')} · ${site.name}`} description={t('description')}>
  <PageHeader current="about" title={t('title')} kicker={t('kicker')} meta={site.name} lead={t('lead')} />
  <main id="main" class="mx-auto w-full max-w-[90rem] px-4 py-14 sm:px-6 sm:py-20 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,46rem)_minmax(0,1fr)] lg:gap-16 lg:px-10">
    <nav aria-label={t('toc')} class="hidden lg:block">
      <ol class="label sticky top-8 space-y-3 text-ink-muted">
        {
          toc.map((s, i) => (
            <li>
              <a class="tap gap-3 hover:text-ink" href={`#${s.id}`}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {s.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="flex min-w-0 flex-col gap-16 text-[1.0625rem] leading-relaxed">
      <Section id="sources" title={t('sources.title')} eyebrow="01">
        <div class="space-y-4">
          <p>{t('sources.jma', { name: `${s.nameJa} (${s.nameEn})`, id: s.id, elevation: s.elevationM })}</p>
          <p class="rounded-xl bg-warn-bg px-4 py-3 text-warn-ink">{t('sources.jmaCaveat')}</p>
          <p>{t('sources.om')}</p>
          <ul class="list-disc space-y-1 pl-6 font-mono text-sm">
            {
              location.forecastPoints.map((p) => (
                <li>{t('sources.point', { label: p.label, lat: p.lat, lon: p.lon, elevation: p.elevationM })}</li>
              ))
            }
          </ul>
          <p>{t('sources.history', { block: s.pastData.blockNo })} <a class="underline" href="/season">/season</a></p>
          <p>{t('sources.refresh')}</p>
        </div>
      </Section>

      <Section id="score" title={t('score.title')} eyebrow="02">
        <p>{t('score.intro')}</p>
        <ul class="mt-4 list-disc space-y-2 pl-6">
          <li>{t('score.fresh')}</li>
          <li>{t('score.more', { max: c.upcoming.maxPoints })}</li>
          <li>{t('score.cold', { cold: c.coldBelowC, coldPts: c.coldPoints, warm: c.warmAboveC, warmPts: pts(c.warmPoints) })}</li>
          <li>
            {
              t('score.wind', {
                breezy: c.breezyMs,
                breezyPts: pts(c.breezyPoints),
                holds: c.holdsMs,
                gust: c.holdsGustMs,
                holdsPts: pts(c.holdsPoints),
              })
            }
          </li>
          <li>{t('score.rain', { mm: c.rainBaseMm, pts: pts(c.rainBasePoints) })}</li>
          <li>{t('score.cap')}</li>
        </ul>
        <p class="mt-4 font-medium">{t('score.verdicts', c.verdicts)}</p>
        <p class="mt-2 text-ink-muted">{t('score.tune')}</p>
      </Section>

      <Section id="limits" title={t('limits.title')} eyebrow="03">
        <ul class="list-disc space-y-2 pl-6">
          <li>{t('limits.1')}</li>
          <li>{t('limits.2')}</li>
          <li>{t('limits.3')}</li>
        </ul>
      </Section>

      <Section id="privacy" title={t('privacy.title')} eyebrow="04">
        <p>{t('privacy.text')}</p>
      </Section>
    </div>
  </main>
</BaseLayout>
