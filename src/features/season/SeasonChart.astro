---
/**
 * Season snow-depth chart. One axis (cm), solid lines told apart by shade + legend +
 * a direct label on the highlighted season's peak. Full version has the hover/keyboard read-out.
 */
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import { dateFromJstDay, formatDayMonth } from '../../lib/format.ts';
import { SEASON_DAYS, dateAt } from '../../lib/season.ts';
import ChartFrame, { type ChartRow } from '../../ui/ChartFrame.astro';
import { SEASON_CHART, seasonChartModel, xAt } from './chart.ts';
import type { SeasonData } from './load.ts';
import { seasonStrings } from './strings.ts';
import type { SeasonSummary } from './summary.ts';

interface Props {
  data: SeasonData;
  summary: SeasonSummary;
  /** Compact = homepage teaser (no axes text, no legend, no interaction). */
  compact?: boolean;
  labelledBy?: string;
  locale?: Locale;
}
const { data, summary, compact = false, labelledBy, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(seasonStrings, locale);
const focus = summary.focus ? (data.seasons[summary.focus]?.depth ?? null) : null;
const compare = !compact && summary.compare ? (data.seasons[summary.compare]?.depth ?? null) : null;
const calendar = summary.focus ?? summary.current;
const m = seasonChartModel({
  focus,
  compare,
  average: summary.avgDepth,
  range: compact ? [] : summary.range,
  season: calendar,
  today: summary.inSeason ? data.today : null,
});
const { width, height, left, top, bottom } = SEASON_CHART;

// Direct labels: the highlighted season's peak, and its latest point while in season.
const lastFocus = focus ? focus.reduce<number>((acc, v, i) => (v !== null ? i : acc), -1) : -1;
const peakIdx = focus ? focus.reduce<number>((best, v, i) => ((v ?? -1) > (focus[best] ?? -1) ? i : best), 0) : -1;
const yOf = (v: number) => top + (height - top - bottom) - (v / m.yMax) * (height - top - bottom);

const cm = (v: number | null | undefined) => (v === null || v === undefined ? '—' : `${Math.round(v)} cm`);
const rows: ChartRow[] = compact
  ? []
  : Array.from({ length: SEASON_DAYS }, (_, i) => {
      const r = summary.range[i];
      const out: [string, string, string][] = [['var(--snow)', cm(focus?.[i]), summary.focus ?? '']];
      if (compare && summary.compare) out.push(['var(--neutral-series)', cm(compare[i]), summary.compare]);
      out.push(['var(--neutral-series-2)', cm(summary.avgDepth[i]), t('legend.average', { n: summary.reference.length })]);
      out.push(['var(--snow-soft)', r ? `${Math.round(r.min)}–${Math.round(r.max)} cm` : '—', t('legend.range')]);
      return { t: formatDayMonth(dateFromJstDay(dateAt(calendar, i))), r: out };
    });
---

{
  compact ? (
    <svg viewBox={`0 0 ${width} ${height}`} class="block w-full" aria-hidden="true">
      <path d={m.averagePath} fill="none" stroke="var(--neutral-series)" stroke-width="2" />
      {m.focusArea && <path d={m.focusArea} fill="var(--snow)" opacity="0.12" />}
      {m.focusPath && <path d={m.focusPath} fill="none" stroke="var(--snow)" stroke-width="2.5" stroke-linejoin="round" />}
      {m.monthTicks.map((tk) => (
        <text x={tk.x} y={height - 8} font-size="20" fill="currentColor" opacity="0.75">
          {tk.label}
        </text>
      ))}
    </svg>
  ) : (
    <figure class="m-0">
      <div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
        <ChartFrame
          xs={Array.from({ length: SEASON_DAYS }, (_, i) => xAt(i))}
          rows={rows}
          viewBoxWidth={width}
          top={top}
          bottom={height - bottom}
          label={t('chart.title')}
          hint={t('chart.hint')}
          class="min-w-[560px]"
        >
          <svg viewBox={`0 0 ${width} ${height}`} class="block w-full text-ink-muted" aria-labelledby={labelledBy} role="img">
            {m.yTicks.map((tk) => (
              <g>
                <line x1={left} x2={width} y1={tk.y} y2={tk.y} stroke="var(--grid)" />
                <text x={left - 6} y={tk.y + 4} text-anchor="end" font-size="12" fill="currentColor">
                  {tk.value}
                </text>
              </g>
            ))}
            {m.rangePath && <path d={m.rangePath} fill="var(--snow)" opacity="0.1" />}
            <path d={m.averagePath} fill="none" stroke="var(--neutral-series-2)" stroke-width="2" stroke-linejoin="round" />
            {m.comparePath && <path d={m.comparePath} fill="none" stroke="var(--neutral-series)" stroke-width="2" stroke-linejoin="round" />}
            {m.focusArea && <path d={m.focusArea} fill="var(--snow)" opacity="0.12" />}
            {m.focusPath && <path d={m.focusPath} fill="none" stroke="var(--snow)" stroke-width="2.5" stroke-linejoin="round" />}
            {focus && peakIdx >= 0 && (focus[peakIdx] ?? 0) > 0 && (
              <g>
                <circle cx={xAt(peakIdx)} cy={yOf(focus[peakIdx] ?? 0)} r="4.5" fill="var(--snow)" stroke="var(--card-solid)" stroke-width="2" />
                <text x={xAt(peakIdx)} y={yOf(focus[peakIdx] ?? 0) - 10} text-anchor="middle" font-size="12" font-weight="650" class="fill-ink">
                  {`${summary.focus} · ${Math.round(focus[peakIdx] ?? 0)} cm`}
                </text>
              </g>
            )}
            {focus && lastFocus >= 0 && summary.inSeason && (
              <circle cx={xAt(lastFocus)} cy={yOf(focus[lastFocus] ?? 0)} r="4.5" fill="var(--snow)" stroke="var(--card-solid)" stroke-width="2" />
            )}
            {m.todayX !== null && <line x1={m.todayX} x2={m.todayX} y1={top} y2={height - bottom} stroke="var(--ink-muted)" stroke-opacity="0.5" />}
            {m.monthTicks.map((tk) => (
              <text x={tk.x} y={height - 8} font-size="12" fill="currentColor">
                {tk.label}
              </text>
            ))}
          </svg>
        </ChartFrame>
      </div>
      <figcaption>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-ink-muted">
          {summary.focus && (
            <li class="flex items-center gap-2">
              <span class="inline-block h-[3px] w-5 rounded bg-snow" />
              {summary.focus}
            </li>
          )}
          {summary.compare && (
            <li class="flex items-center gap-2">
              <span class="inline-block h-0.5 w-5 rounded" style="background:var(--neutral-series)" />
              {summary.compare}
            </li>
          )}
          <li class="flex items-center gap-2">
            <span class="inline-block h-0.5 w-5 rounded" style="background:var(--neutral-series-2)" />
            {t('legend.average', { n: summary.reference.length })}
          </li>
          <li class="flex items-center gap-2">
            <span class="inline-block h-3 w-5 rounded-sm bg-snow/15" />
            {t('legend.range')}
          </li>
        </ul>
      </figcaption>
    </figure>
  )
}
