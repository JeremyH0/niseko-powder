---
/** The /season page body: summary, chart, stats for the highlighted season, every past winter. */
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import { dateFromJstDay, formatDayMonth } from '../../lib/format.ts';
import Section from '../../ui/Section.astro';
import StatTile from '../../ui/StatTile.astro';
import type { SeasonData } from './load.ts';
import SeasonChart from './SeasonChart.astro';
import { seasonStrings } from './strings.ts';
import type { SeasonSummary } from './summary.ts';
import { seasonSentences } from './summary-text.ts';

interface Props {
  data: SeasonData;
  summary: SeasonSummary;
  locale?: Locale;
}
const { data, summary, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(seasonStrings, locale);
const s = summary.focusStats;
const sentences = seasonSentences(summary, locale);
const on = (date: string | undefined) => (date ? t('stats.on', { date: formatDayMonth(dateFromJstDay(date)) }) : undefined);

const complete = summary.table.filter((r) => r.complete);
const best = complete.reduce<string | null>(
  (b, r) => (!b || r.stats.totalSnowfallCm > (complete.find((x) => x.season === b)?.stats.totalSnowfallCm ?? 0) ? r.season : b),
  null,
);
const avg = (pick: (r: (typeof complete)[number]) => number) =>
  complete.length ? Math.round(complete.reduce((a, r) => a + pick(r), 0) / complete.length) : 0;
const first = summary.table.at(-1)?.season ?? '';
---

<div class="flex flex-col gap-14">
  <div class="rounded-3xl border border-line bg-card p-4 sm:p-6">
    <div id="season-summary" class="space-y-1 text-lg leading-snug">
      {sentences.map((line) => <p>{line}</p>)}
    </div>
    <h2 class="mt-5 mb-2 text-sm font-medium text-ink-muted">{t('chart.title')}</h2>
    <SeasonChart data={data} summary={summary} labelledBy="season-summary" locale={locale} />
  </div>

  {
    s && summary.focus && (
      <Section id="season-stats" title={t('stats.title', { season: summary.focus })}>
        <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          <StatTile label={t('stats.total')} value={String(s.totalSnowfallCm)} unit="cm" />
          <StatTile
            label={t('stats.deepest')}
            value={s.maxDepth ? String(s.maxDepth.cm) : '—'}
            unit={s.maxDepth ? 'cm' : undefined}
            note={on(s.maxDepth?.date)}
          />
          <StatTile
            label={t('stats.biggest')}
            value={s.biggestDay ? String(s.biggestDay.cm) : '—'}
            unit={s.biggestDay ? 'cm' : undefined}
            note={on(s.biggestDay?.date)}
          />
          <StatTile label={t('stats.days20')} value={String(s.days20)} />
        </dl>
      </Section>
    )
  }

  <Section id="season-table" title={t('table.title', { first })}>
    <div class="overflow-x-auto rounded-3xl border border-line bg-card">
      <table class="w-full min-w-[520px] text-left text-sm">
        <thead class="text-ink-muted">
          <tr>
            <th scope="col" class="px-4 py-3 font-medium">{t('table.season')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('table.total')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('table.deepest')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('table.biggest')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('table.days20')}</th>
          </tr>
        </thead>
        <tbody>
          {
            summary.table.map((r) => (
              <tr class:list={['border-t border-line', r.season === summary.focus && 'bg-highlight']}>
                <th scope="row" class="px-4 py-2.5 font-semibold">
                  {r.season}
                  {r.season === best && (
                    <span class="ml-2 rounded-full bg-snow px-2 py-0.5 text-xs font-semibold text-white">{t('table.best')}</span>
                  )}
                  {!r.complete && <span class="ml-2 text-xs font-normal text-ink-muted">{t('table.soFar')}</span>}
                </th>
                <td class="num px-4 py-2.5 text-right">{r.stats.totalSnowfallCm} cm</td>
                <td class="num px-4 py-2.5 text-right">{r.stats.maxDepth ? `${r.stats.maxDepth.cm} cm` : '—'}</td>
                <td class="num px-4 py-2.5 text-right">{r.stats.biggestDay ? `${r.stats.biggestDay.cm} cm` : '—'}</td>
                <td class="num px-4 py-2.5 text-right">{r.stats.days20}</td>
              </tr>
            ))
          }
          <tr class="border-t-2 border-line text-ink-muted">
            <th scope="row" class="px-4 py-2.5 font-medium">{t('table.average')}</th>
            <td class="num px-4 py-2.5 text-right">{avg((r) => r.stats.totalSnowfallCm)} cm</td>
            <td class="num px-4 py-2.5 text-right">{avg((r) => r.stats.maxDepth?.cm ?? 0)} cm</td>
            <td class="num px-4 py-2.5 text-right">{avg((r) => r.stats.biggestDay?.cm ?? 0)} cm</td>
            <td class="num px-4 py-2.5 text-right">{avg((r) => r.stats.days20)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-ink-muted">{t('source', { source: data.source })}</p>
  </Section>
</div>
