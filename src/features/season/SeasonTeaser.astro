---
/** Homepage card: one sentence + a mini chart, linking to /season. */
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import Section from '../../ui/Section.astro';
import type { SeasonData } from './load.ts';
import SeasonChart from './SeasonChart.astro';
import { seasonStrings } from './strings.ts';
import type { SeasonSummary } from './summary.ts';
import { seasonSentences } from './summary-text.ts';

interface Props {
  data: SeasonData;
  summary: SeasonSummary;
  locale?: Locale;
}
const { data, summary, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(seasonStrings, locale);
const [sentence] = seasonSentences(summary, locale);
---

<Section id="season" title={t('teaser.title')} badge={t('badge')} eyebrow="03">
  <a
    href="/season"
    class="glass reveal group season-card rounded-3xl p-4 transition hover:border-snow sm:p-6"
  >
    <div>
      <p id="season-teaser-text" class="text-lg leading-snug">{sentence}</p>
      <p class="mt-3 font-semibold text-accent">
        {t('teaser.cta')} <span aria-hidden="true" class="inline-block transition group-hover:translate-x-1">→</span>
      </p>
    </div>
    <div class="text-ink-muted" aria-label={t('teaser.chartLabel')} role="img">
      <SeasonChart data={data} summary={summary} compact locale={locale} />
    </div>
  </a>
</Section>
