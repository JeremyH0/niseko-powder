---
import { LINKS } from '../../config/links.ts';
import { DEFAULT_LOCATION_ID } from '../../config/locations.ts';
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import Icon from '../../ui/Icon.astro';
import Section from '../../ui/Section.astro';
import { linksStrings } from './strings.ts';

interface Props {
  locationId?: string;
  locale?: Locale;
}
const { locationId = DEFAULT_LOCATION_ID, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(linksStrings, locale);
const links = LINKS[locationId] ?? [];
---

<Section id="links" title={t('title')} intro={t('intro')} eyebrow="05">
  <ul class="links-grid">
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            rel="noopener"
            class="glass group flex h-full items-start gap-3 rounded-2xl p-4 transition hover:-translate-y-0.5 hover:border-snow"
          >
            <span class="rounded-xl bg-highlight p-2 text-accent">
              <Icon name={l.icon} size={22} />
            </span>
            <span class="min-w-0">
              <span class="flex items-center gap-1 font-semibold">
                {t(`${l.id}.title`)}
                <Icon name="external" size={14} class="text-ink-muted transition group-hover:text-accent" />
              </span>
              <span class="mt-0.5 block text-sm text-ink-muted">{t(`${l.id}.desc`)}</span>
              <span class="sr-only">{t('external')}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
