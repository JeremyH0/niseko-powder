---
import { LINKS } from '../../config/links.ts';
import { DEFAULT_LOCATION_ID } from '../../config/locations.ts';
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import Icon from '../../ui/Icon.astro';
import Section from '../../ui/Section.astro';
import { linksStrings } from './strings.ts';

interface Props {
  locationId?: string;
  locale?: Locale;
}
const { locationId = DEFAULT_LOCATION_ID, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(linksStrings, locale);
const links = LINKS[locationId] ?? [];
---

<Section id="links" title={t('title')} intro={t('intro')} eyebrow="05">
  <ol class="border-t border-line">
    {
      links.map((l, i) => (
        <li class="border-b border-line">
          <a href={l.href} rel="noopener" class="index-row index-grid py-5 sm:py-7">
            <span class="label pl-1 text-ink-muted" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="index-title font-display text-[clamp(1.9rem,1.4rem+2vw,3.25rem)] leading-none">
              {t(`${l.id}.title`)}
              <span class="sr-only">{t('external')}</span>
            </span>
            <span class="col-start-2 mt-2 flex items-center gap-2 text-sm text-ink-muted @[48rem]:col-start-3 @[48rem]:row-start-1 @[48rem]:mt-0">
              <Icon name={l.icon} size={16} class="shrink-0" />
              {t(`${l.id}.desc`)}
            </span>
            <span class="index-arrow col-start-3 row-span-2 row-start-1 grid h-11 w-11 place-items-center rounded-full border border-line @[48rem]:col-start-4 @[48rem]:row-span-1">
              <Icon name="arrow" size={18} rotate={45} />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</Section>
