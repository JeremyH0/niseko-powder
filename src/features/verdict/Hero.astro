---
/**
 * The answer. Big word, plain-English headline, score and reasons, on a sky that
 * follows the JST time of day and the weather. The `atmosphere` slot takes the snowfall canvas.
 */
import { site } from '../../config/site.ts';
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import type { Conditions, PowderReason } from '../../lib/data/types.ts';
import { formatAge, formatClock, formatFullDate, formatTemp } from '../../lib/format.ts';
import { minutesBetween } from '../../lib/time.ts';
import { verdictCopy } from './copy.ts';
import Mountains from './Mountains.astro';
import ScoreRing from './ScoreRing.astro';
import { verdictStrings } from './strings.ts';

interface Props {
  conditions: Conditions | null;
  now: Date;
  locale?: Locale;
}

const { conditions, now, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(verdictStrings, locale);
const { model: m, question, word, headline } = verdictCopy(conditions, now, locale);
const powder = conditions?.powder;

function reasonText(r: PowderReason): string {
  const p = r.params ?? {};
  return t(`reason.${r.code}`, {
    cm: Math.round(p.cm ?? 0),
    mm: Math.round(p.mm ?? 0),
    ms: Math.round(p.ms ?? 0),
    temp: formatTemp(p.tempC),
    age: formatAge(p.minutes ?? 0),
  });
}
// Most informative first: things that changed the score, then context. Max 4 chips.
const reasons = [...(powder?.reasons ?? [])]
  .sort((a, b) => Math.abs(b.points) - Math.abs(a.points))
  .slice(0, 4);

const obsAge = conditions?.observed ? minutesBetween(conditions.observed.observedAt, now) : null;
const dataAge = conditions ? minutesBetween(conditions.generatedAt, now) : null;
const delayedBy =
  obsAge !== null && obsAge > site.staleAfterMinutes
    ? obsAge
    : dataAge !== null && dataAge > site.staleAfterMinutes
      ? dataAge
      : null;
const updatedAt = conditions?.observed?.observedAt ?? conditions?.generatedAt ?? null;
---

<header
  class="sky relative isolate flex min-h-[min(92svh,860px)] flex-col overflow-hidden sm:min-h-[min(100svh,900px)]"
  data-sky={m.sky}
  data-weather={m.weather}
  data-verdict={powder?.verdict ?? 'none'}
>
  <slot name="atmosphere" />

  <div class="relative z-10 mx-auto flex w-full max-w-5xl flex-1 flex-col px-4 pt-4 pb-[clamp(170px,27vw,380px)] sm:px-6">
    <nav class="flex items-center justify-between gap-3 text-sm" aria-label="Site">
      <a href="/" class="flex items-center gap-2 whitespace-nowrap font-semibold tracking-tight">
        <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"
          ><g stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
            ><path d="M16 4v24M5.6 10l20.8 12M5.6 22l20.8-12"></path></g
          ></svg
        >
        {site.name}
      </a>
      {
        delayedBy !== null ? (
          <a href="#right-now" class="num whitespace-nowrap rounded-full bg-amber-300 px-2.5 py-1 text-xs font-semibold text-amber-950">
            {t('delayed', { age: formatAge(delayedBy) })}
          </a>
        ) : (
          updatedAt && (
            <a href="#right-now" class="num whitespace-nowrap rounded-full bg-white/15 px-2.5 py-1 text-xs font-medium backdrop-blur-sm hover:bg-white/25">
              {t('updated', { time: formatClock(updatedAt) })}
            </a>
          )
        )
      }
    </nav>

    <div class="sky-text-shadow mt-[8vh] flex flex-1 flex-col justify-start sm:mt-[10vh]">
      <p class="rise text-sm font-medium uppercase tracking-[0.18em] opacity-85" style="--i:0">
        {t('today.label')} · {formatFullDate(now)}
      </p>
      <h1 class="mt-3">
        <span class="rise block text-xl font-medium sm:text-2xl" style="--i:1">{question}</span>
        <span
          class="rise mt-1 block font-display text-[clamp(4.5rem,22vw,11rem)] font-black leading-[0.9] tracking-tight"
          style="--i:2">{word}</span
        >
      </h1>
      <p class="rise mt-5 max-w-xl text-lg leading-snug sm:text-2xl" style="--i:3">{headline}</p>

      <div class="rise mt-7 flex flex-wrap items-center gap-x-6 gap-y-4" style="--i:4">
        {powder && <ScoreRing score={powder.score} label={t('score.label')} of={t('score.of')} />}
        {
          reasons.length > 0 && (
            <ul class="flex max-w-xl flex-wrap gap-2 text-sm" aria-label="Why">
              {reasons.map((r) => (
                <li
                  class:list={[
                    'rounded-full px-3 py-1 backdrop-blur-sm',
                    r.points > 0 && 'bg-white/25 font-medium',
                    r.points < 0 && 'bg-black/25 ring-1 ring-amber-200/70',
                    r.points === 0 && 'bg-white/12',
                  ]}
                >
                  {r.points > 0 ? '▲ ' : r.points < 0 ? '▼ ' : ''}
                  {reasonText(r)}
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <p class="rise mt-4 text-sm" style="--i:5">
        <a href="/about#score" class="underline decoration-white/50 hover:decoration-white">{t('score.how')}</a>
      </p>
    </div>
  </div>

  <Mountains snowcap={m.snowcap} annupuriLabel={t('mountain.annupuri')} yoteiLabel={t('mountain.yotei')} />
  <slot name="controls" />
</header>
