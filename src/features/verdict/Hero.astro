---
/**
 * The answer. Big frosted word, plain-English headline, then a glass panel with the
 * powder score, the powder stake and the reasons — on a sky that follows the real
 * sunrise/sunset at Niseko and the weather. The `atmosphere` slot takes the snowfall canvas.
 */
import { site } from '../../config/site.ts';
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import type { Conditions, PowderReason } from '../../lib/data/types.ts';
import { formatAge, formatClock, formatFullDate, formatTemp } from '../../lib/format.ts';
import { minutesBetween } from '../../lib/time.ts';
import SiteNav from '../../ui/SiteNav.astro';
import { verdictCopy } from './copy.ts';
import Mountains from './Mountains.astro';
import PowderStake from './PowderStake.astro';
import ScoreRing from './ScoreRing.astro';
import { verdictStrings } from './strings.ts';

interface Props {
  conditions: Conditions | null;
  now: Date;
  locale?: Locale;
}

const { conditions, now, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(verdictStrings, locale);
const { model: m, question, word, headline } = verdictCopy(conditions, now, locale);
const powder = conditions?.powder;

function reasonText(r: PowderReason): string {
  const p = r.params ?? {};
  return t(`reason.${r.code}`, {
    cm: Math.round(p.cm ?? 0),
    mm: Math.round(p.mm ?? 0),
    ms: Math.round(p.ms ?? 0),
    temp: formatTemp(p.tempC),
    age: formatAge(p.minutes ?? 0),
  });
}
// Most informative first: what changed the score, then context. Max 4 chips.
const reasons = [...(powder?.reasons ?? [])]
  .filter((r) => `reason.${r.code}` in verdictStrings.en)
  .sort((a, b) => Math.abs(b.points) - Math.abs(a.points))
  .slice(0, 4);

const obsAge = conditions?.observed ? minutesBetween(conditions.observed.observedAt, now) : null;
const dataAge = conditions ? minutesBetween(conditions.generatedAt, now) : null;
const delayedBy =
  obsAge !== null && obsAge > site.staleAfterMinutes
    ? obsAge
    : dataAge !== null && dataAge > site.staleAfterMinutes
      ? dataAge
      : null;
const updatedAt = conditions?.observed?.observedAt ?? conditions?.generatedAt ?? null;
---

<header
  id="top"
  class="sky relative isolate flex flex-col overflow-hidden sm:min-h-[min(94svh,920px)] xl:min-h-svh"
  data-sky={m.sky}
  data-weather={m.weather}
  data-verdict={powder?.verdict ?? 'none'}
>
  <div class="stars pointer-events-none absolute inset-x-0 top-0 h-[65%]" aria-hidden="true"></div>
  <slot name="atmosphere" />

  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col px-4 pt-[max(1rem,env(safe-area-inset-top))] pb-[clamp(170px,28vw,400px)] xl:pb-[clamp(380px,calc(28vw+40px),570px)] sm:px-6 lg:px-8">
    <SiteNav variant="overlay" current="home">
      {
        delayedBy !== null ? (
          <a href="#right-now" class="ml-1 rounded-full bg-amber-300 px-2.5 py-1 text-xs font-semibold whitespace-nowrap text-amber-950">
            {t('delayed', { age: formatAge(delayedBy) })}
          </a>
        ) : (
          updatedAt && (
            <a href="#right-now" class="ml-1 hidden rounded-full bg-white/15 px-2.5 py-1 text-xs font-medium whitespace-nowrap backdrop-blur-sm hover:bg-white/25 sm:inline">
              {t('updated', { time: formatClock(updatedAt) })}
            </a>
          )
        )
      }
    </SiteNav>

    <div class="sky-text mt-8 grid flex-1 content-start gap-y-8 sm:mt-[8vh] xl:mt-[5vh] xl:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] xl:items-end xl:gap-x-12">
      <div>
      <p class="rise flex flex-wrap gap-x-3 gap-y-1 text-[0.8rem] font-medium tracking-[0.16em] uppercase opacity-90" style="--i:0">
        <span>{t('today.label')} · {formatFullDate(now)}</span>
        <span class="tracking-normal normal-case opacity-90">
          {t('sun', { rise: formatClock(m.sunrise), set: formatClock(m.sunset) })}
        </span>
      </p>
      <h1 class="mt-3">
        <span class="rise block text-xl font-medium sm:text-2xl" style="--i:1">{question}</span>
        <span class="mt-1 block">
          <span class="frost settle block font-display text-[clamp(5.75rem,3rem+18vw,14rem)] leading-[0.82] font-normal tracking-[-0.02em]">{word}</span>
        </span>
      </h1>
      <p class="rise mt-5 max-w-2xl text-lg leading-snug text-balance sm:text-2xl" style="--i:3">{headline}</p>
      </div>

      {
        powder && (
          <div
            class="rise grid max-w-4xl grid-cols-2 gap-x-3 gap-y-4 rounded-3xl border border-white/15 bg-white/10 p-4 backdrop-blur-md sm:grid-cols-[auto_auto_1fr] sm:items-center sm:gap-8 sm:p-5 xl:grid-cols-2 xl:gap-6 xl:p-6"
            style="--i:4"
          >
            <ScoreRing score={powder.score} label={t('score.label')} of={t('score.of')} />
            <PowderStake
              cm={powder.freshCm}
              label={t('stake.label')}
              note={t('stake.note')}
              feel={{
                none: t('stake.none'),
                dusting: t('stake.dusting'),
                ankle: t('stake.ankle'),
                boot: t('stake.boot'),
                knee: t('stake.knee'),
                deep: t('stake.deep'),
              }}
              landmarks={{ ankle: t('stake.mark.ankle'), boot: t('stake.mark.boot'), knee: t('stake.mark.knee') }}
            />
            <div class="col-span-2 min-w-0 sm:col-span-1 sm:border-l sm:border-white/15 sm:pl-6 xl:col-span-2 xl:border-t xl:border-l-0 xl:pt-5 xl:pl-0">
              {reasons.length > 0 && (
                <ul class="flex flex-wrap gap-2 text-sm" aria-label={t('reasons.label')}>
                  {reasons.map((r) => (
                    <li
                      class:list={[
                        'rounded-full px-3 py-1',
                        r.points > 0 && 'bg-white/25 font-medium',
                        r.points < 0 && 'bg-black/25 ring-1 ring-amber-200/70',
                        r.points === 0 && 'bg-white/12',
                      ]}
                    >
                      <span aria-hidden="true">{r.points > 0 ? '▲ ' : r.points < 0 ? '▼ ' : ''}</span>
                      {reasonText(r)}
                    </li>
                  ))}
                </ul>
              )}
              <div class="mt-2 flex flex-wrap items-center gap-x-4">
                <a href="/about#score" class="tap text-sm underline decoration-white/50 hover:decoration-white">
                  {t('score.how')}
                </a>
                <slot name="share" />
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>

  <Mountains snowline={m.snowline} light={m.light} annupuriLabel={t('mountain.annupuri')} yoteiLabel={t('mountain.yotei')} />
  <slot name="controls" />
</header>
