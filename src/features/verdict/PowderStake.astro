---
/**
 * The powder stake: a snow stake like the ones on the slopes, filled to the fresh-snow
 * estimate, with ankle / boot-top / knee marks. The number is real text beside it.
 */
import { LANDMARKS, depthFeel, stakeMax } from './depth.ts';

interface Props {
  cm: number;
  label: string;
  feel: Record<ReturnType<typeof depthFeel>, string>;
  landmarks: Record<(typeof LANDMARKS)[number]['key'], string>;
  note: string;
}
const { cm, label, feel, landmarks, note } = Astro.props;
const max = stakeMax(cm);
const H = 120;
const top = 6;
const y = (v: number) => top + H - (Math.min(v, max) / max) * H;
const fillY = y(cm);
const ticks = Array.from({ length: max / 10 + 1 }, (_, i) => i * 10);
---

<figure class="flex h-full flex-col justify-between gap-3" aria-label={`${label}: ${Math.round(cm)} cm — ${feel[depthFeel(cm)]}`}>
  <figcaption class="label opacity-85">{label}</figcaption>
  <div class="flex items-end justify-between gap-2">
    <span class="numeral min-w-0 text-[clamp(3.6rem,2.6rem+3vw,5.5rem)]" aria-hidden="true">{Math.round(cm)}<span class="label ml-1 align-top opacity-80">cm</span></span>
  <svg viewBox="0 0 92 132" aria-hidden="true" class="h-[92px] w-[64px] shrink-0 overflow-visible sm:h-[112px] sm:w-[78px]">
    <!-- stake -->
    <rect x="18" y={top - 2} width="16" height={H + 4} rx="3" fill="rgb(255 255 255 / 0.1)" stroke="rgb(255 255 255 / 0.35)" />
    {
      ticks.map((v) => (
        <g>
          <line x1="18" x2={v % 20 === 0 ? 30 : 25} y1={y(v)} y2={y(v)} stroke="rgb(255 255 255 / 0.6)" />
          {v % 20 === 0 && (
            <text x="13" y={y(v) + 3.5} text-anchor="end" font-size="9" fill="rgb(255 255 255 / 0.75)" style="font-family:var(--font-mono)">
              {v}
            </text>
          )}
        </g>
      ))
    }
    <!-- snow -->
    {
      cm >= 0.5 && (
        <path
          class="fill-up"
          d={`M10 ${top + H + 2} L10 ${fillY + 3} Q18 ${fillY - 3} 26 ${fillY} T42 ${fillY + 1} L42 ${top + H + 2} Z`}
          fill="#f4f9ff"
        />
      )
    }
    <!-- landmarks -->
    {
      LANDMARKS.filter((l) => l.cm <= max).map((l) => (
        <g>
          <line x1="38" x2="46" y1={y(l.cm)} y2={y(l.cm)} stroke="rgb(255 255 255 / 0.5)" />
          <text x="49" y={y(l.cm) + 3.5} font-size="9" fill="rgb(255 255 255 / 0.85)" style="font-family:var(--font-mono)">
            {landmarks[l.key]}
          </text>
        </g>
      ))
    }
  </svg>
  </div>
  <p class="text-sm font-medium" aria-hidden="true">{feel[depthFeel(cm)]}</p>
  <p class="-mt-2 hidden max-w-[16rem] text-xs leading-snug opacity-75 sm:block">{note}</p>
</figure>
