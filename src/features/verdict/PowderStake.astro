---
/**
 * The powder stake: a snow stake like the ones on the slopes, filled to the fresh-snow
 * estimate, with ankle / boot-top / knee marks. The number is real text beside it.
 */
import { LANDMARKS, depthFeel, stakeMax } from './depth.ts';

interface Props {
  cm: number;
  label: string;
  feel: Record<ReturnType<typeof depthFeel>, string>;
  landmarks: Record<(typeof LANDMARKS)[number]['key'], string>;
  note: string;
}
const { cm, label, feel, landmarks, note } = Astro.props;
const max = stakeMax(cm);
const H = 120;
const top = 6;
const y = (v: number) => top + H - (Math.min(v, max) / max) * H;
const fillY = y(cm);
const ticks = Array.from({ length: max / 10 + 1 }, (_, i) => i * 10);
---

<figure class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-4" aria-label={`${label}: ${Math.round(cm)} cm — ${feel[depthFeel(cm)]}`}>
  <svg viewBox="0 0 92 132" aria-hidden="true" class="h-[106px] w-[74px] shrink-0 overflow-visible sm:h-[132px] sm:w-[92px]">
    <!-- stake -->
    <rect x="18" y={top - 2} width="16" height={H + 4} rx="4" fill="rgb(255 255 255 / 0.12)" stroke="rgb(255 255 255 / 0.35)" />
    {
      ticks.map((v) => (
        <g>
          <line x1="18" x2={v % 20 === 0 ? 30 : 25} y1={y(v)} y2={y(v)} stroke="rgb(255 255 255 / 0.6)" />
          {v % 20 === 0 && (
            <text x="13" y={y(v) + 3.5} text-anchor="end" font-size="9" fill="rgb(255 255 255 / 0.75)">
              {v}
            </text>
          )}
        </g>
      ))
    }
    <!-- snow -->
    {
      cm >= 0.5 && (
        <path
          class="fill-up"
          d={`M10 ${top + H + 2} L10 ${fillY + 3} Q18 ${fillY - 3} 26 ${fillY} T42 ${fillY + 1} L42 ${top + H + 2} Z`}
          fill="#f4f9ff"
        />
      )
    }
    <!-- landmarks -->
    {
      LANDMARKS.filter((l) => l.cm <= max).map((l) => (
        <g>
          <line x1="38" x2="46" y1={y(l.cm)} y2={y(l.cm)} stroke="rgb(255 255 255 / 0.5)" />
          <text x="49" y={y(l.cm) + 3.5} font-size="9.5" fill="rgb(255 255 255 / 0.85)">
            {landmarks[l.key]}
          </text>
        </g>
      ))
    }
  </svg>
  <figcaption class="leading-tight">
    <span class="block text-xs font-medium tracking-wide opacity-80">{label}</span>
    <span class="mt-1 block text-[1.75rem] font-semibold tracking-tight sm:text-[2rem]">{Math.round(cm)}<span class="ml-0.5 text-base font-medium opacity-80">cm</span></span>
    <span class="block text-sm font-semibold">{feel[depthFeel(cm)]}</span>
    <span class="mt-1 hidden max-w-[11rem] text-xs opacity-75 sm:block">{note}</span>
  </figcaption>
</figure>
