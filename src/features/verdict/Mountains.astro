---
/**
 * The hero landscape: far hills, Yōtei, the Annupuri range, valley fog, a fir forest edge and
 * the near snowfield (painted in the page colour so the hero melts into the content).
 * Geometry comes from landscape.ts; colours from the sky tokens, so the scene follows the
 * time of day and the weather.
 */
import { landscape, type Light, type Snowline } from './landscape.ts';

interface Props {
  snowline: Snowline;
  light: Light;
  annupuriLabel: string;
  yoteiLabel: string;
}
const { snowline, light, annupuriLabel, yoteiLabel } = Astro.props;
const l = landscape({ snowline, light });
const [ax, ay] = l.range.summit;
const [yx, yy] = l.yotei.summit;
---

<div class="pointer-events-none absolute inset-x-0 bottom-0" aria-hidden="true">
  <svg viewBox="0 0 1200 320" preserveAspectRatio="xMidYMax slice" class="block h-[clamp(160px,28vw,530px)] w-full">
    <defs>
      <linearGradient id="haze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--fog)" stop-opacity="0"></stop>
        <stop offset="0.65" stop-color="var(--fog)"></stop>
        <stop offset="1" stop-color="var(--fog)" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id="yotei-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--ridge-far)"></stop>
        <stop offset="1" stop-color="var(--distant)"></stop>
      </linearGradient>
      <linearGradient id="range-fill" x1="0" y1="0.15" x2="0" y2="1">
        <stop offset="0" stop-color="var(--ridge-mid)"></stop>
        <stop offset="1" stop-color="var(--ridge-near)"></stop>
      </linearGradient>
      <linearGradient id="shade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#040b1c" stop-opacity="0.3"></stop>
        <stop offset="1" stop-color="#040b1c" stop-opacity="0.06"></stop>
      </linearGradient>
      <linearGradient id="snow-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--cap)"></stop>
        <stop offset="1" stop-color="var(--cap)" stop-opacity="0.82"></stop>
      </linearGradient>
    </defs>

    <!-- Far horizon -->
    <path d={l.distant} fill="var(--distant)" opacity="0.7"></path>

    <!-- Yōtei, hazed by distance -->
    <path d={l.yotei.body} fill="url(#yotei-fill)"></path>
    {l.yotei.snow && <path d={l.yotei.snow} fill="url(#snow-fill)" opacity="0.92"></path>}
    <path d={l.yotei.shadow} fill="url(#shade)" opacity="0.75"></path>
    <text x={yx - 24} y={yy - 12} text-anchor="end" font-size="19" fill="#fff" opacity="0.72" font-family="system-ui, sans-serif">{yoteiLabel}</text>

    <!-- Valley fog between the volcano and the range -->
    <rect class="fog" x="-60" y="168" width="1320" height="96" fill="url(#haze)"></rect>

    <!-- Niseko Annupuri range -->
    <path d={l.range.body} fill="url(#range-fill)"></path>
    {l.range.snow && <path d={l.range.snow} fill="url(#snow-fill)"></path>}
    <path d={l.range.shadow} fill="url(#shade)"></path>
    <text x={ax - 34} y={ay - 14} text-anchor="start" font-size="19" fill="#fff" opacity="0.78" font-family="system-ui, sans-serif">{annupuriLabel}</text>

    <!-- Low fog, then the fir forest edge -->
    <rect class="fog" style="animation-delay:-9s" x="-60" y="226" width="1320" height="56" fill="url(#haze)" opacity="0.85"></rect>
    <path d={l.forest.ground} fill="var(--ridge-near)"></path>
    <path d={l.forest.trees} fill="var(--ridge-near)"></path>

    <!-- Near snowfield in the page colour -->
    <path d={l.front} fill="var(--paper)"></path>
  </svg>
</div>
