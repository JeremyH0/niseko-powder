---
/** Powder score: a big serif figure with a thin meter ring. The figure is real text. */
interface Props {
  score: number;
  label: string;
  of: string;
}
const { score, label, of } = Astro.props;
const r = 44;
const full = 2 * Math.PI * r;
const offset = full * (1 - Math.max(0, Math.min(100, score)) / 100);
---

<figure class="flex h-full flex-col justify-between gap-3" aria-label={`${label}: ${score} ${of}`}>
  <div class="flex items-start justify-between gap-3">
    <figcaption class="label opacity-85">{label}</figcaption>
    <svg viewBox="0 0 100 100" aria-hidden="true" class="h-9 w-9 shrink-0 -rotate-90 sm:h-11 sm:w-11">
      <circle cx="50" cy="50" r={r} fill="none" stroke="rgb(255 255 255 / 0.18)" stroke-width="8"></circle>
      <circle
        class="ring-in"
        cx="50"
        cy="50"
        r={r}
        fill="none"
        stroke="var(--ring)"
        stroke-width="8"
        stroke-linecap="round"
        stroke-dasharray={full}
        stroke-dashoffset={offset}
        style={`--ring-full:${full}`}></circle>
    </svg>
  </div>
  <span class="numeral text-[clamp(3.6rem,2.6rem+3vw,5.5rem)]" aria-hidden="true">{score}<span class="label ml-1 align-top opacity-80">/100</span></span>
</figure>
