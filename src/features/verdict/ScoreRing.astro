---
/** Powder score as a meter ring. The figure is sans, proportional (dataviz hero-figure rule). */
interface Props {
  score: number;
  label: string;
  of: string;
}
const { score, label, of } = Astro.props;
const r = 42;
const full = 2 * Math.PI * r;
const offset = full * (1 - Math.max(0, Math.min(100, score)) / 100);
---

<figure class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-4" aria-label={`${label}: ${score} ${of}`}>
  <svg viewBox="0 0 100 100" aria-hidden="true" class="h-16 w-16 shrink-0 -rotate-90 sm:h-[92px] sm:w-[92px]">
    <circle cx="50" cy="50" r={r} fill="none" stroke="rgb(255 255 255 / 0.16)" stroke-width="9"></circle>
    <circle
      class="ring-in"
      cx="50"
      cy="50"
      r={r}
      fill="none"
      stroke="var(--ring)"
      stroke-width="9"
      stroke-linecap="round"
      stroke-dasharray={full}
      stroke-dashoffset={offset}
      style={`--ring-full:${full}`}></circle>
  </svg>
  <figcaption class="leading-tight">
    <span class="block text-xs font-medium tracking-wide opacity-80">{label}</span>
    <span class="mt-1 block text-[1.75rem] font-semibold tracking-tight sm:text-[2rem]">{score}<span class="ml-0.5 text-base font-medium opacity-80">/100</span></span>
  </figcaption>
</figure>
