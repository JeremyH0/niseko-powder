---
interface Props {
  score: number;
  label: string;
  of: string;
}
const { score, label, of } = Astro.props;
const r = 44;
const full = 2 * Math.PI * r;
const offset = full * (1 - Math.max(0, Math.min(100, score)) / 100);
---

<figure class="flex items-center gap-3" aria-label={`${label}: ${score} ${of}`}>
  <svg viewBox="0 0 100 100" width="76" height="76" aria-hidden="true" class="shrink-0 -rotate-90">
    <circle cx="50" cy="50" r={r} fill="none" stroke="rgb(255 255 255 / 0.18)" stroke-width="8"></circle>
    <circle
      cx="50"
      cy="50"
      r={r}
      fill="none"
      stroke="var(--ring)"
      stroke-width="8"
      stroke-linecap="round"
      stroke-dasharray={full}
      stroke-dashoffset={offset}
      style={`--ring-full:${full}; animation: ring 1.4s cubic-bezier(.2,.7,.2,1) .5s both`}></circle>
  </svg>
  <figcaption class="leading-tight">
    <span class="num block font-display text-3xl font-semibold">{score}<span class="text-base opacity-70">/100</span></span>
    <span class="text-sm opacity-85">{label}</span>
  </figcaption>
</figure>
