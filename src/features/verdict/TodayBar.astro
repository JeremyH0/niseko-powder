---
/**
 * Slim sticky bar with today's answer, shown once the hero has scrolled out of view
 * (IntersectionObserver), so the verdict stays one glance away while reading the forecast.
 * Without JavaScript it never appears — the hero already has everything.
 */
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import type { Conditions } from '../../lib/data/types.ts';
import { formatClock, formatCm } from '../../lib/format.ts';
import { verdictCopy } from './copy.ts';
import { verdictStrings } from './strings.ts';

interface Props {
  conditions: Conditions | null;
  now: Date;
  locale?: Locale;
}
const { conditions, now, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(verdictStrings, locale);
const { word } = verdictCopy(conditions, now, locale);
const p = conditions?.powder;
const updatedAt = conditions?.observed?.observedAt ?? conditions?.generatedAt ?? null;
---

<div class="today-bar fixed inset-x-0 top-0 z-40 border-b border-line pt-[env(safe-area-inset-top)]" data-today-bar>
  <div class="mx-auto flex min-h-14 max-w-[90rem] items-center gap-4 px-4 sm:px-6 lg:px-10">
    <a href="#top" class="tap flex items-baseline gap-2" aria-label={t('bar.top')}>
      <span class="font-display text-[1.9rem] leading-none">{word}</span>
    </a>
    {
      p && (
        <p class="label flex items-center gap-3 text-ink-muted">
          <span>
            <strong class="font-medium text-ink">{p.score}</strong>/100
          </span>
          <span aria-hidden="true">·</span>
          <span>
            {t('bar.fresh')} <strong class="font-medium text-ink">{formatCm(p.freshCm)} cm</strong>
          </span>
        </p>
      )
    }
    <span class="label ml-auto hidden text-ink-muted sm:inline">{updatedAt && t('updated', { time: formatClock(updatedAt) })}</span>
    <a href="/season" class="label tap hidden rounded-full px-3 hover:bg-highlight md:inline-flex">{t('bar.season')}</a>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-today-bar]');
  const hero = document.querySelector('header.sky');
  if (bar && hero) {
    new IntersectionObserver(([entry]) => bar.classList.toggle('is-visible', !(entry?.isIntersecting ?? true)), {
      rootMargin: '-40% 0px 0px 0px',
    }).observe(hero);
  }
</script>
