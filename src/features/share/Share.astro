---
/** Native share sheet (or copy link) — the "send it to the group chat" morning habit. */
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import Icon from '../../ui/Icon.astro';
import { shareStrings } from './strings.ts';

interface Props {
  /** The verdict word and headline, already translated. */
  word: string;
  headline: string;
  url: string;
  /** `hero` = compact glass pill on the sky. */
  variant?: 'hero' | 'block';
  locale?: Locale;
}
const { word, headline, url, variant = 'block', locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(shareStrings, locale);
---

<div class:list={variant === 'block' ? 'flex flex-col items-center gap-3 text-center' : 'contents'}>
  <button
    type="button"
    data-share
    data-text={t('text', { word, headline })}
    data-url={url}
    data-copied={t('copied')}
    class:list={[
      'js-only inline-flex min-h-11 items-center gap-2 rounded-full font-semibold transition hover:-translate-y-0.5',
      variant === 'block' && 'bg-ink px-5 py-3 text-paper shadow-lg shadow-ink/10',
      variant === 'hero' && 'bg-white px-4 text-sm text-[#0b1b2f] shadow-lg shadow-black/20',
    ]}
  >
    <Icon name="share" size={variant === 'hero' ? 16 : 18} />
    {variant === 'hero' ? t('short') : t('button')}
  </button>
  <p data-share-status role="status" class:list={['text-sm font-medium', variant === 'block' ? 'min-h-5 text-good' : 'basis-full text-white']}></p>
  {variant === 'block' && <p class="max-w-md text-sm text-ink-muted">{t('habit')}</p>}
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-share]');
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  button?.addEventListener('click', async () => {
    const { text = '', url = location.href, copied = '' } = button.dataset;
    try {
      if (navigator.share) {
        await navigator.share({ text, url });
        return;
      }
      await navigator.clipboard.writeText(`${text} ${url}`);
      if (status) status.textContent = copied;
    } catch {
      // Share sheet dismissed — nothing to do.
    }
  });
</script>
