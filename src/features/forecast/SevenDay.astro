---
import { powderConfig } from '../../config/powder.ts';
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import { findPoint } from '../../lib/data/forecast.ts';
import type { Conditions } from '../../lib/data/types.ts';
import { dateFromJstDay, formatCm, formatDayMonth, formatTemp, formatWeekday } from '../../lib/format.ts';
import { jstDate } from '../../lib/time.ts';
import Icon from '../../ui/Icon.astro';
import Section from '../../ui/Section.astro';
import { weatherIcon } from '../../ui/weather-icon.ts';
import { forecastStrings } from './strings.ts';

interface Props {
  conditions: Conditions | null;
  now: Date;
  locale?: Locale;
}
const { conditions, now, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(forecastStrings, locale);

const summit = findPoint(conditions, 'summit');
const mid = findPoint(conditions, 'mid');
const base = findPoint(conditions, 'base');
const today = jstDate(now);

const days = (summit?.daily ?? []).map((d) => {
  const m = mid?.daily.find((x) => x.date === d.date);
  const b = base?.daily.find((x) => x.date === d.date);
  return {
    date: d.date,
    summitCm: d.snowfallCm ?? 0,
    midCm: m?.snowfallCm ?? 0,
    summitMin: d.tMinC,
    summitMax: d.tMaxC,
    baseMax: b?.tMaxC ?? null,
    baseRain: b?.rainMm ?? 0,
    wind: m?.windMaxMs ?? d.windMaxMs,
    gust: d.gustMaxMs,
    code: m?.weatherCode ?? d.weatherCode,
  };
});
const scaleMax = Math.max(20, ...days.map((d) => d.summitCm));
---

{
  days.length > 0 && (
    <Section id="week" title={t('week.title')} badge={t('week.badge')}>
      <ol class="overflow-hidden rounded-3xl border border-line bg-card">
        {days.map((d, i) => {
          const big = d.summitCm >= powderConfig.bigSnowCm;
          const windy = (d.wind ?? 0) >= powderConfig.holdsMs || (d.gust ?? 0) >= powderConfig.holdsGustMs;
          return (
            <li
              class:list={[
                'grid grid-cols-[4.2rem_2rem_1fr_auto] items-center gap-x-3 gap-y-1 px-4 py-3 sm:grid-cols-[6rem_2rem_1fr_auto_13rem] sm:px-6',
                i > 0 && 'border-t border-line',
                big && 'bg-highlight',
              ]}
            >
              <div class="leading-tight">
                <span class="block font-semibold">{d.date === today ? t('week.today') : formatWeekday(dateFromJstDay(d.date))}</span>
                <span class="num text-xs text-ink-muted">{formatDayMonth(dateFromJstDay(d.date))}</span>
              </div>
              <Icon name={weatherIcon(d.code)} size={24} class="text-ink-muted" />
              <div class="min-w-0">
                <div class="h-3 overflow-hidden rounded-full bg-ink/5" aria-hidden="true">
                  <div
                    class="grow-x h-full rounded-full bg-snow"
                    style={`width:${Math.max(d.summitCm > 0 ? 3 : 0, (d.summitCm / scaleMax) * 100)}%; --i:${i}`}
                  />
                </div>
                <p class="mt-1 flex flex-wrap gap-x-3 text-xs text-ink-muted">
                  {big && <span class="font-semibold text-snow">{t('week.bigSnow')}</span>}
                  {d.midCm >= 1 && (
                    <span class="num">
                      {t('week.mid')} {formatCm(d.midCm)} cm
                    </span>
                  )}
                  {d.baseRain >= 1 && (
                    <span class="num text-rain">
                      {Math.round(d.baseRain)} mm {t('week.rainBase')}
                    </span>
                  )}
                  {windy && (
                    <span class="flex items-center gap-1 font-medium text-warn-ink">
                      <Icon name="wind" size={12} />
                      {t('week.windy')}
                    </span>
                  )}
                </p>
              </div>
              <p class="num text-right" aria-label={t('week.snowLabel', { cm: formatCm(d.summitCm) })}>
                <span class="font-display text-2xl font-semibold">{formatCm(d.summitCm)}</span>
                <span class="text-sm text-ink-muted"> cm</span>
              </p>
              <p class="num col-span-4 text-xs text-ink-muted sm:col-span-1 sm:whitespace-nowrap sm:text-right sm:text-sm">
                {t('week.summit')} {formatTemp(d.summitMin)}/{formatTemp(d.summitMax)} · {t('week.base')} {formatTemp(d.baseMax)}
              </p>
            </li>
          );
        })}
      </ol>
      {conditions?.forecast && <p class="mt-3 text-xs text-ink-muted">{t('week.source', { model: conditions.forecast.model })}</p>}
    </Section>
  )
}
