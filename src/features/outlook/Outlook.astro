---
/** Four tiles straight under the hero: the numbers people check every morning. */
import { powderConfig } from '../../config/powder.ts';
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import { findPoint } from '../../lib/data/forecast.ts';
import type { Conditions } from '../../lib/data/types.ts';
import { dateFromJstDay, formatCm, formatTemp, formatWeekday } from '../../lib/format.ts';
import { jstDate } from '../../lib/time.ts';
import StatTile from '../../ui/StatTile.astro';
import { outlookStrings } from './strings.ts';

interface Props {
  conditions: Conditions | null;
  now: Date;
  locale?: Locale;
}
const { conditions, now, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(outlookStrings, locale);
const p = conditions?.powder;
const summit = findPoint(conditions, 'summit');
const summitFresh = formatCm(summit?.past24hSnowfallCm ?? 0);

const freshNote =
  p?.freshSource === 'town'
    ? t('fresh.town')
    : p?.freshSource === 'mountain'
      ? t('fresh.mountain', { summit: summitFresh })
      : t('fresh.none', { summit: summitFresh });

const big = p?.nextBigSnow ?? null;
const bigValue = big ? (big.date === jstDate(now) ? t('big.next24') : formatWeekday(dateFromJstDay(big.date))) : t('big.none');
const bigNote = big ? t('big.note', { cm: formatCm(big.snowfallCm) }) : t('big.noneNote', { cm: powderConfig.bigSnowCm });

const obs = conditions?.observed;
const townTemp = obs?.tempC.ok ? obs.tempC.value : null;
const wet = obs?.precip1hMm.ok && (obs.precip1hMm.value ?? 0) > 0;
const townNote = wet ? ((townTemp ?? 0) > 1 ? t('town.note.rain') : t('town.note.snow')) : t('town.note.dry');
---

<section aria-label={t('title')} class="relative z-20 mx-auto -mt-10 w-full max-w-5xl px-4 sm:-mt-16 sm:px-6">
  <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    <StatTile class="rise shadow-lg shadow-ink/5" label={t('fresh.label')} value={formatCm(p?.freshCm)} unit="cm" note={freshNote} />
    <StatTile class="rise shadow-lg shadow-ink/5" label={t('next24.label')} value={formatCm(p?.next24hCm)} unit="cm" note={t('next24.note')} />
    <StatTile class="rise shadow-lg shadow-ink/5" label={t('big.label')} value={bigValue} note={bigNote} muted={!big} />
    <StatTile class="rise shadow-lg shadow-ink/5" label={t('town.label')} value={formatTemp(townTemp)} note={townNote} />
  </dl>
</section>
