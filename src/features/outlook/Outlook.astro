---
/** Four big numbers straight under the hero, on a hairline grid: the morning check. */
import { powderConfig } from '../../config/powder.ts';
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../../i18n/index.ts';
import { findPoint } from '../../lib/data/forecast.ts';
import type { Conditions } from '../../lib/data/types.ts';
import { dateFromJstDay, formatCm, formatTemp, formatWeekday } from '../../lib/format.ts';
import { jstDate } from '../../lib/time.ts';
import StatTile from '../../ui/StatTile.astro';
import { outlookStrings } from './strings.ts';

interface Props {
  conditions: Conditions | null;
  now: Date;
  locale?: Locale;
}
const { conditions, now, locale = DEFAULT_LOCALE } = Astro.props;
const t = createTranslator(outlookStrings, locale);
const p = conditions?.powder;
const summit = findPoint(conditions, 'summit');
const summitFresh = formatCm(summit?.past24hSnowfallCm ?? 0);

const freshNote =
  p?.freshSource === 'town'
    ? t('fresh.town')
    : p?.freshSource === 'mountain'
      ? t('fresh.mountain', { summit: summitFresh })
      : t('fresh.none', { summit: summitFresh });

const big = p?.nextBigSnow ?? null;
const bigValue = big ? (big.date === jstDate(now) ? t('big.next24') : formatWeekday(dateFromJstDay(big.date))) : t('big.none');
const daysAway = big ? Math.round((Date.parse(`${big.date}T00:00:00Z`) - Date.parse(`${jstDate(now)}T00:00:00Z`)) / 86_400_000) : 0;
const when = daysAway <= 0 ? '' : daysAway === 1 ? t('big.tomorrow') : t('big.inDays', { n: daysAway });
const bigNote = big
  ? [t('big.note', { cm: formatCm(big.snowfallCm) }), when].filter(Boolean).join(' · ')
  : t('big.noneNote', { cm: powderConfig.bigSnowCm });

const obs = conditions?.observed;
const townTemp = obs?.tempC.ok ? obs.tempC.value : null;
const wet = obs?.precip1hMm.ok && (obs.precip1hMm.value ?? 0) > 0;
const townNote = wet ? ((townTemp ?? 0) > 1 ? t('town.note.rain') : t('town.note.snow')) : t('town.note.dry');
---

<section aria-label={t('title')} class="mx-auto w-full max-w-[90rem] px-4 pt-10 sm:px-6 sm:pt-14 lg:px-10">
  <h2 class="label mb-4 flex items-center justify-between gap-4 text-ink-muted">
    <span>{t('title')}</span>
    <span class="hidden text-right sm:inline">{t('habit')}</span>
  </h2>
  <dl class="ruled grid-cols-2 lg:grid-cols-4">
    <StatTile size="lg" label={t('fresh.label')} value={formatCm(p?.freshCm)} unit="cm" note={freshNote} />
    <StatTile size="lg" label={t('next24.label')} value={formatCm(p?.next24hCm)} unit="cm" note={t('next24.note')} />
    <StatTile size="lg" label={t('big.label')} value={bigValue} note={bigNote} muted={!big} />
    <StatTile size="lg" label={t('town.label')} value={formatTemp(townTemp)} note={townNote} />
  </dl>
  <p class="mt-3 text-[0.8125rem] text-ink-muted sm:hidden">{t('habit')}</p>
</section>
