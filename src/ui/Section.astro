---
/** A page section: optional eyebrow number, display heading, "where is this measured" badge. */
interface Props {
  id: string;
  title: string;
  badge?: string;
  intro?: string;
  /** Editorial index, e.g. "01". */
  eyebrow?: string;
  class?: string;
}
const { id, title, badge, intro, eyebrow, class: className } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={['min-w-0 scroll-mt-6', className]}>
  <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    {eyebrow && <span class="tabular text-sm font-semibold text-accent" aria-hidden="true">{eyebrow}</span>}
    <h2 id={`${id}-title`} class="font-display text-[2.1rem] leading-[1.05] font-normal sm:text-5xl">{title}</h2>
    {
      badge && (
        <span class="glass rounded-full px-2.5 py-0.5 text-xs font-medium text-ink-muted">
          {badge}
        </span>
      )
    }
  </div>
  {intro && <p class="-mt-2 mb-4 max-w-prose text-sm text-ink-muted">{intro}</p>}
  <slot />
</section>
