---
/**
 * A page section, set like a magazine department: a heavy rule, a mono meta line
 * (index · where the data comes from), then a big serif title that wipes in on scroll.
 */
interface Props {
  id: string;
  title: string;
  /** Where this is measured / modelled, e.g. "Town station · 176 m". */
  badge?: string;
  intro?: string;
  /** Editorial index, e.g. "01". */
  eyebrow?: string;
  class?: string;
}
const { id, title, badge, intro, eyebrow, class: className } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={['min-w-0 scroll-mt-20', className]}>
  <header class="mb-6 border-t border-rule pt-3 sm:mb-8">
    {
      (eyebrow || badge) && (
        <p class="label flex flex-wrap justify-between gap-x-4 gap-y-1 text-ink-muted">
          {eyebrow && <span aria-hidden="true">({eyebrow})</span>}
          {badge && <span>{badge}</span>}
        </p>
      )
    }
    <h2 id={`${id}-title`} class="title-in mt-4 font-display text-[clamp(2.4rem,1.7rem+2.6vw,4.25rem)] leading-[0.95] font-normal tracking-[-0.015em] sm:mt-5">
      {title}
    </h2>
    {intro && <p class="mt-3 max-w-prose text-[0.95rem] text-ink-muted">{intro}</p>}
  </header>
  <slot />
</section>
