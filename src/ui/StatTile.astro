---
/**
 * A labelled number (dataviz stat-tile contract): label · value (sans semibold,
 * proportional figures) · optional note. Real text for screen readers, crawlers, no-JS.
 */
interface Props {
  label: string;
  value: string;
  unit?: string;
  note?: string;
  muted?: boolean;
  class?: string;
}
const { label, value, unit, note, muted = false, class: className } = Astro.props;
---

<div class:list={['glass rounded-2xl p-4', className]}>
  <dt class="text-xs font-medium tracking-wide text-ink-muted">{label}</dt>
  <dd class="mt-1 flex items-baseline gap-1">
    <span class:list={['text-3xl font-semibold tracking-tight sm:text-[2rem]', muted && 'text-ink-muted']}>{value}</span>
    {unit && <span class="text-sm font-medium text-ink-muted">{unit}</span>}
    <slot />
  </dd>
  {note && <dd class="mt-1 text-xs leading-snug text-ink-muted">{note}</dd>}
</div>
