---
import '../ui/global.css';
import { attributions, site } from '../config/site.ts';
import { common } from '../i18n/common.ts';
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../i18n/index.ts';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Browser UI colour (matches the top of the hero sky). */
  themeColor?: string;
}

const { title, description, locale = DEFAULT_LOCALE, themeColor = '#0a1533' } = Astro.props;
const t = createTranslator(common, locale);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Respect the OS text size (Dynamic Type etc.); everything is sized in rem. -->
    <meta name="text-scale" content="scale" />
    <!-- Instant navigation: prerender our own pages when the visitor shows intent (hover / touch start). -->
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          {
            "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/api/*" } }] },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-ink px-5 py-3 text-paper focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >{t('a11y.skip')}</a
    >
    <slot />
    <footer class="mt-auto border-t border-line">
      <div class="mx-auto grid max-w-5xl gap-6 px-4 py-10 text-sm text-ink-muted sm:grid-cols-[1.4fr_1fr] sm:px-6">
        <div>
          <p class="font-display text-2xl font-normal text-ink">{site.name}</p>
          <p class="mt-1 max-w-md">{t('footer.about')}</p>
          <p class="mt-3">{t('footer.nonCommercial')}</p>
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
            <a class="tap font-medium text-ink underline" href="/season">{t('footer.season')}</a>
            <a class="tap font-medium text-ink underline" href="/about">{t('footer.methodology')}</a>
            <a class="tap font-medium text-ink underline" href="/api/conditions.json">{t('footer.api')}</a>
          </p>
        </div>
        <div>
          <p class="font-medium text-ink">{t('footer.credits')}</p>
          <ul class="mt-1">
            {
              attributions.map((a) => (
                <li>
                  <a class="tap underline" href={a.href} rel="noopener">
                    {a.text}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mt-3">{t('footer.disclaimer')}</p>
          <p class="mt-3">{t('footer.madeIn')}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
