---
import '../ui/global.css';
import { getLocation } from '../config/locations.ts';
import { attributions, site } from '../config/site.ts';
import { common } from '../i18n/common.ts';
import { createTranslator, DEFAULT_LOCALE, type Locale } from '../i18n/index.ts';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Browser UI colour (matches the top of the hero sky). */
  themeColor?: string;
}

const { title, description, locale = DEFAULT_LOCALE, themeColor = '#0a1533' } = Astro.props;
const t = createTranslator(common, locale);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const station = getLocation().station;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Respect the OS text size (Dynamic Type etc.); everything is sized in rem. -->
    <meta name="text-scale" content="scale" />
    <!-- Instant navigation: prerender our own pages when the visitor shows intent (hover / touch start). -->
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          {
            "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/api/*" } }] },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-ink px-5 py-3 text-paper focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >{t('a11y.skip')}</a
    >
    <slot />
    <footer class="relative isolate mt-auto overflow-hidden bg-band text-band-ink">
      <div class="mx-auto max-w-[90rem] px-4 pt-16 sm:px-6 sm:pt-24 lg:px-10">
        <div class="grid gap-12 border-t border-current/30 pt-4 md:grid-cols-12 md:gap-8">
          <div class="md:col-span-5">
            <p class="label opacity-70">{site.name}</p>
            <p class="mt-6 max-w-md font-display text-[clamp(1.9rem,1.4rem+1.6vw,2.75rem)] leading-[1.05]">{t('footer.about')}</p>
            <p class="mt-5 max-w-sm text-sm opacity-75">{t('footer.nonCommercial')}</p>
          </div>
          <nav aria-label={t('footer.index')} class="md:col-span-3 md:col-start-7">
            <p class="label opacity-70">{t('footer.index')}</p>
            <ul class="mt-4 text-[0.95rem]">
              <li><a class="tap" href="/season"><span class="link-draw">{t('footer.season')}</span></a></li>
              <li><a class="tap" href="/about"><span class="link-draw">{t('footer.methodology')}</span></a></li>
              <li><a class="tap" href="/api/conditions.json"><span class="link-draw">{t('footer.api')}</span></a></li>
              <li><a class="tap" href="#top"><span class="link-draw">{t('footer.top')} ↑</span></a></li>
            </ul>
          </nav>
          <div class="md:col-span-3">
            <p class="label opacity-70">{t('footer.credits')}</p>
            <ul class="mt-4 text-[0.95rem]">
              {
                attributions.map((a) => (
                  <li>
                    <a class="tap" href={a.href} rel="noopener">
                      <span class="link-draw">{a.text}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="mt-4 text-sm leading-relaxed opacity-75">{t('footer.disclaimer')}</p>
          </div>
        </div>
        <p class="label mt-16 flex flex-wrap justify-between gap-x-6 gap-y-1 opacity-70">
          <span>{t('footer.madeIn')}</span>
          <span>{t('footer.coords', { lat: station.lat.toFixed(2), lon: station.lon.toFixed(2) })}</span>
        </p>
      </div>
      <p class="wordmark mt-6 -mb-[0.16em] px-[1.5vw] select-none" aria-hidden="true">{site.name}</p>
    </footer>
  </body>
</html>
